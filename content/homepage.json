{
	"$schema": "./homepage.schema.json",
	"version": 1,
	"presets": {
		"launch-full": [
			"hero",
			"infrastructure",
			"customer",
			"closing",
			"footer"
		],
		"launch": [
			"hero",
			"closing",
			"footer"
		],
		"docs-first": [
			"hero",
			"quickstart",
			"closing",
			"footer"
		],
		"launch-sota": [
			"hero",
			"logos",
			"terminal",
			"infrastructure",
			"pricing",
			"closing",
			"footer"
		]
	},
	"preset": "launch-sota",
	"locales": {
