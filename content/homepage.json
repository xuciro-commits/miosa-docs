			"prefix": "",
			"htmlLang": "en",
			"dir": "ltr"
		},
		"zh": {
			"prefix": "/zh",
			"htmlLang": "zh-CN",
			"dir": "ltr"
		}
	},
	"defaultLocale": "en",
	"sections": {
		"hero": {
			"type": "hero",
