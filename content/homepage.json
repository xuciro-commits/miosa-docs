			},
			"lead": "home.terminal.lead",
			"caption": "home.terminal.caption",
			"lines": [
				{
					"kind": "prompt",
					"text": "$ npm install -g @miosa/cli@latest"
				},
				{
					"kind": "output",
					"text": "added 1 package in 2s"
				},
				{
					"kind": "prompt",
					"text": "$ miosa create my-box --wait"
				},
				{
					"kind": "output",
					"text": "sandbox my-box ready \u00b7 2 vCPU \u00b7 4 GB"
				},
				{
					"kind": "prompt",
					"text": "$ miosa exec my-box -- echo hello"
				},
				{
					"kind": "output",
					"text": "hello"
				},
				{
					"kind": "comment",
					"text": "# share a live preview"
				},
				{
					"kind": "prompt",
					"text": "$ miosa preview my-box 3000"
				},
				{
					"kind": "output",
					"text": "https://my-box.preview.miosa.ai"
