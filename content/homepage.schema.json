{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Homepage definition",
	"description": "Sections of the marketing homepage. Copy is referenced by translation key so both locales stay in step.",
	"type": "object",
	"required": ["version", "preset", "presets", "locales", "defaultLocale", "sections"],
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"version": { "const": 1 },
		"preset": { "type": "string" },
		"presets": {
			"type": "object",
			"additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
		},
		"locales": {
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"required": ["prefix", "htmlLang", "dir"],
				"properties": {
					"prefix": { "type": "string" },
					"htmlLang": { "type": "string" },
					"dir": { "enum": ["ltr", "rtl"] },
					"og": { "type": "string" }
				}
			}
		},
		"defaultLocale": { "type": "string" },
		"sections": {
			"type": "object",
			"additionalProperties": { "$ref": "#/definitions/section" }
		}
	},
	"definitions": {
		"link": {
			"type": "object",
			"required": ["label", "href"],
			"additionalProperties": false,
			"properties": {
				"label": { "$ref": "#/definitions/key" },
				"href": { "type": "string", "minLength": 1 }
			}
		},
		"key": {
			"description": "Translation key under the marketing namespace.",
			"type": "string",
			"pattern": "^(nav|home|footer|status)\\.[A-Za-z0-9.]+$"
		},
		"heading": {
			"type": "object",
			"additionalProperties": { "$ref": "#/definitions/key" }
		},
		"item": {
			"type": "object",
			"required": ["title", "text"],
			"additionalProperties": false,
			"properties": {
				"title": { "$ref": "#/definitions/key" },
				"text": { "$ref": "#/definitions/key" },
				"href": { "type": "string" }
			}
		},
		"section": {
			"type": "object",
			"required": ["type"],
			"properties": {
				"type": {
					"enum": ["hero", "features", "steps", "split", "cta", "footer"]
				},
				"eyebrow": { "$ref": "#/definitions/key" },
				"title": { "$ref": "#/definitions/heading" },
				"lead": {
					"oneOf": [{ "$ref": "#/definitions/key" }, { "$ref": "#/definitions/heading" }]
				},
				"numbered": { "type": "boolean" },
				"items": { "type": "array", "maxItems": 6, "items": { "$ref": "#/definitions/item" } },
				"primary": { "$ref": "#/definitions/link" },
				"secondary": { "$ref": "#/definitions/link" },
				"cta": { "$ref": "#/definitions/link" },
				"link": { "$ref": "#/definitions/link" },
				"announcement": {
					"type": "object",
					"required": ["label", "text", "href"],
					"properties": {
						"label": { "$ref": "#/definitions/key" },
						"text": { "$ref": "#/definitions/key" },
						"href": { "type": "string" }
					}
				},
				"benchmark": {
					"type": "object",
					"required": ["value", "label", "href"],
					"properties": {
						"value": { "type": "string" },
						"label": { "$ref": "#/definitions/key" },
						"href": { "type": "string" }
					}
				},
				"command": { "type": "string" },
				"commandLabels": {
					"type": "object",
					"required": ["aria", "idle", "done", "manual"],
					"properties": {
						"aria": { "$ref": "#/definitions/key" },
						"idle": { "$ref": "#/definitions/key" },
						"done": { "$ref": "#/definitions/key" },
						"manual": { "$ref": "#/definitions/key" }
					}
				},
				"statement": { "$ref": "#/definitions/heading" },
				"columns": {
					"type": "array",
					"maxItems": 8,
					"items": {
						"type": "object",
						"required": ["title", "links"],
						"properties": {
							"title": { "$ref": "#/definitions/key" },
							"links": {
								"type": "array",
								"minItems": 1,
								"maxItems": 8,
								"items": { "$ref": "#/definitions/link" }
							}
						}
					}
				},
				"navLabel": { "$ref": "#/definitions/key" },
				"copyright": { "$ref": "#/definitions/key" },
				"about": { "$ref": "#/definitions/link" },
				"github": { "type": "string" }
			}
		}
	}
}
