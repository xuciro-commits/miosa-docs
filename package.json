{
	"name": "miosa-docs",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "node build",
		"test": "playwright test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:static": "node scripts/build-static.mjs",
		"preview:static": "node scripts/serve-static.mjs",
		"verify:deployment": "node scripts/verify-deployment.mjs",
		"build:spa": "node scripts/build-spa.mjs",
		"qa:content": "node scripts/content-qa.mjs",
		"qa:content:staged": "node scripts/content-qa.mjs --staged",
		"qa:routes": "node scripts/route-qa.mjs",
		"verify:http": "node scripts/verify-http.mjs",
		"hooks:install": "git config core.hooksPath .githooks",
		"docs:export": "node scripts/export-docs.mjs",
		"content:publish": "node scripts/publish-content.mjs",
		"qa:content:sync": "node scripts/check-content-sync.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@types/three": "^0.187.0",
		"mdsvex": "^0.12.7",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.70.0",
		"@scalar/api-reference": "^1.77.0",
		"@shikijs/langs": "^4.6.0",
		"@shikijs/themes": "^4.6.0",
		"bits-ui": "^2.20.6",
		"mermaid": "^12.3.0",
		"shiki": "^4.6.0",
		"three": "^0.187.0"
	}
}
